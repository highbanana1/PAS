extends SceneTree
var failures: Array[String] = []
func _initialize() -> void: run.call_deferred()
func check(ok: bool, label: String) -> void:
	print(("PASS: " if ok else "FAIL: ") + label)
	if not ok: failures.append(label)
func run() -> void:
	var game = load("res://scene/main.tscn").instantiate()
	root.add_child(game); current_scene = game
	var p = game.get_node("CharacterBody2D")
	p.set_physics_process(false); game.get_node("enemy").set_physics_process(false)
	var w = p.get_weapon_controller(); w.set_process(false); w.equip_weapon(1)
	var sword = p.get_node("Sword"); sword.set_physics_process(false)
	var guard = p.get_guard_component()
	w.set_guarding(true, Vector2.RIGHT)
	check(w.attack(Vector2.RIGHT) and sword.is_swinging and not w.is_guarding, "Attack command immediately cancels guard and starts one swing")
	w.set_guarding(true)
	check(not w.is_guarding, "A swing cannot be interrupted by held guard input")
	sword.reset_state(); w.set_guarding(true)
	await process_frame
	Input.action_press("block"); Input.action_press("fire")
	w.get_node("LocalCombatInput").tick(0.0)
	check(sword.is_swinging and not w.is_guarding, "Left click attacks while right click is held")
	Input.action_release("fire"); Input.action_release("block")
	sword.reset_state(); guard.reset_state()
	w.set_guarding(true); guard.tick(10)
	w.set_guarding(false); guard.tick(7.5)
	w.equip_weapon(0); w.equip_weapon(1); w.set_guarding(true)
	check(not w.is_guarding and guard.exhausted, "Weapon switching cannot bypass exhaustion at half recovery")
	check(w.attack(Vector2.RIGHT) and sword.is_swinging, "Exhaustion locks defense but still permits attacking")
	sword.reset_state(); w.set_guarding(false); guard.tick(7.5); w.set_guarding(true)
	check(w.is_guarding and not guard.exhausted, "Guard becomes available again only at full recovery")
	guard.tick(10.0); w.equip_weapon(0)
	await process_frame
	Input.action_press("block"); Input.action_press("fire")
	w.get_node("LocalCombatInput").tick(1.0)
	var bullets := get_nodes_in_group("bullet")
	check(bullets.size() == 1 and bullets[0].shooter == p, "Gun still fires with right click held while sword guard is exhausted")
	check(not w.is_guarding and guard.exhausted and guard.value > 0, "Gun ignores guard requests and allows exhausted meter recovery")
	check(p.get_node("gun").aim_direction.is_equal_approx(w.aim_direction), "Gun aim still follows the controller independently of guard lock")
	Input.action_release("block"); Input.action_release("fire")
	for bullet in bullets: bullet.free()
	game.free()
	print("RESULT: ", failures.size(), " failures")
	quit(0 if failures.is_empty() else 1)
