extends SceneTree
var failures: Array[String] = []
func _initialize() -> void: run.call_deferred()
func check(ok: bool, label: String) -> void:
	print(("PASS: " if ok else "FAIL: ") + label)
	if not ok: failures.append(label)
func run() -> void:
	var actor = load("res://scene/maincharac.tscn").instantiate()
	actor.is_locally_controlled = false
	root.add_child(actor)
	actor.set_physics_process(false)
	var controller = actor.get_node("WeaponController")
	controller.set_process(false)
	check(controller.has_method("register_weapon") and actor.has_method("get_guard_component"), "Actor exposes registered weapons and a separate guard component")
	if not controller.has_method("register_weapon"):
		actor.free(); quit(1); return
	var container := Node2D.new()
	container.name = "ArbitraryWeaponMount"
	actor.add_child(container)
	var gun = load("res://scene/gun.tscn").instantiate()
	container.add_child(gun)
	controller.register_weapon(9, gun)
	controller.equip_weapon(9)
	controller.aim(Vector2.LEFT)
	check(controller.current_weapon == 9 and gun.active and not actor.get_node("Sword").active, "A separately mounted weapon registers without controller special casing")
	check(controller.attack(Vector2.LEFT), "Remote actor can attack via an explicit command")
	var shots = get_nodes_in_group("bullet")
	check(shots.size() == 1 and shots[0].shooter == actor and shots[0].global_transform.x.x < 0, "Unified attack preserves projectile owner and requested direction")
	for shot in shots: shot.free()
	Input.action_press("fire")
	controller._process(0.0)
	Input.action_release("fire")
	check(get_nodes_in_group("bullet").is_empty(), "Remote controller never polls local fire input")
	controller.cycle_weapon(1)
	check(controller.current_weapon == 0, "Wheel cycling uses registered weapon order")
	var Guard = load("res://scene/script/components/guard_component.gd")
	var Context = load("res://scene/script/combat/attack_context.gd")
	var guard = Guard.new(); container.add_child(guard); guard.configure(actor)
	guard.request_guard(true, Vector2.RIGHT)
	for frame in range(600): guard.tick(1.0/60.0)
	check(guard.value == 0.0 and not guard.is_guarding and actor.get_guard_component().value == 100.0, "Guard clocks are independent and drain exactly once")
	guard.tick(15.0)
	check(guard.value == 0.0, "Exhausted held guard cannot regenerate")
	guard.request_guard(false, Vector2.RIGHT); guard.tick(15.0)
	check(guard.value == 100.0, "Generic guard fully recovers in fifteen seconds after release")
	guard.request_guard(true,Vector2.RIGHT)
	check(not guard.try_block(Context.new(1,actor.global_position+Vector2(40,0),null,false)) and guard.value == 100.0, "Unblockable damage bypasses generic guard")
	check(guard.try_block(Context.new(1,actor.global_position+Vector2(40,0))) and guard.value == 80.0, "Generic directional guard uses twenty per successful block")
	controller.equip_weapon(1)
	controller.set_guarding(false)
	check(controller.attack(Vector2.RIGHT), "Sword implements the same attack interface")
	controller.equip_weapon(0)
	check(not actor.get_node("Sword").is_swinging, "Switching weapons cancels a common attack lifecycle")
	actor.is_dead = true
	controller.refresh_equipped_weapon()
	check(not controller.attack(Vector2.RIGHT), "Dead owner cannot issue a weapon attack")
	actor.free()
	var robot := CharacterBody2D.new()
	robot.position = Vector2(1800,-300)
	root.add_child(robot)
	var Controller = load("res://scene/script/weapon_controller.gd")
	var generic = Controller.new()
	root.add_child(generic)
	generic.configure(robot)
	generic.set_process(false)
	var mount := Node2D.new(); root.add_child(mount)
	mount.global_position = robot.global_position
	var blade = load("res://scene/sword.tscn").instantiate()
	blade.scale = Vector2(0.03,0.03)
	mount.add_child(blade)
	generic.register_weapon(7,blade); generic.equip_weapon(7)
	blade.set_process(false); blade.set_physics_process(false)
	var target = load("res://scene/enemy.tscn").instantiate()
	target.scale = Vector2(0.045,0.045)
	target.position = robot.position + Vector2(24,0)
	root.add_child(target); target.set_physics_process(false)
	await physics_frame
	await physics_frame
	check(generic.attack(Vector2.RIGHT), "Sword can attack for an arbitrary body from an unrelated mount")
	blade._physics_process(0.3)
	check(target.health == 3 and not blade.is_swinging, "A large physics interval crossing the sweep still hits exactly once")
	generic.free(); mount.free(); robot.free(); target.free()
	print("RESULT: ", failures.size(), " failures")
	quit(0 if failures.is_empty() else 1)
